XREVIVE_VERSION=0.1.0-beta.5-live.6
DEBIAN_SUITE=trixie
XEMU_VERSION=0.8.138
# sha256 registrado no primeiro download (2026-10-21)
XEMU_SHA256=c921b43d615020adfa9fe05bc02d7c2c56bd1f12e0152af3d332bbe9bd864884
# Tamanhos das particoes do pendrive (MiB)
SYSTEM_MIB=2048
CONSOLE_MIB=128
# CACHE: particao ext4 gravavel, persistente (cache de shaders e dados do xemu,
# por maquina). Nao vai para a RAM; fica no pendrive.
CACHE_MIB=1024
# UTILS e dimensionada em emit-image.sh conforme o catalogo Rocky5 normalizado.
# Permanece ext4 somente leitura e nao vai para a RAM.
# Driver do dongle sem fio do Xbox (fork mantido de medusalix/xone)
XONE_VERSION=0.5.8
XONE_SHA256=f1905d5046ce79b94df0501045008203c4ae4ce6f43dbcf8bd04d7c944bf420e
# Proprietario (Maxwell); nvidia-open nao suporta a GTX 750.
NVIDIA_VERSION=550.163.01-2

# exFAT para firmware, ISOs próprias e staging persistente; USB >=16 GB.
USERS_MIB=10240
