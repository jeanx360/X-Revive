+/* X-Revive: handle the same tray operations requested by Xbox software.
+ * Run block operations in the main loop, then update the SMC state/IRQ so
+ * dashboards can distinguish open from closed and send the next operation.
+ */
+static void smc_tray_operation(void *opaque)
+{
+    unsigned value = GPOINTER_TO_UINT(opaque);
+    Error *err = NULL;
+
+    if (value == 0) {
+        qmp_eject("ide0-cd1", NULL, true, true, &err);
+    } else {
+        qmp_blockdev_close_tray("ide0-cd1", NULL, &err);
+    }
+    if (err) {
+        error_report_err(err);
+        return;
+    }
+    xbox_smc_update_tray_state();
+}
+
 static int smc_write_data(SMBusDevice *dev, uint8_t *buf, uint8_t len)
 {
     SMBusSMCDevice *smc = XBOX_SMC(dev);
@@ -138,6 +162,13 @@
             qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
         } else if (buf[0] & SMC_REG_POWER_SHUTDOWN) {
             qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+        }
+        break;
+
+    case SMC_REG_TRAYEJECT:
+        if (buf[0] <= 1) {
+            aio_bh_schedule_oneshot(qemu_get_aio_context(), smc_tray_operation,
+                                     GUINT_TO_POINTER((unsigned)buf[0]));
         }
         break;
 
