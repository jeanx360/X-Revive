// Splash de boot do X-Revive: fundo preto, logo centralizado e uma fileira de
// pontos que pulsam em onda (indica carregamento durante a copia para a RAM).

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

// --- logo ---
logo.image = Image("logo.png");
// Keep the logo and its messages visible on small displays as well.
max_logo = Math.Min(sw - 80, sh - 190);
if (logo.image.GetHeight() > max_logo) {
    ratio = max_logo / logo.image.GetHeight();
    logo.image = logo.image.Scale(logo.image.GetWidth() * ratio, max_logo);
}
logo.sprite = Sprite(logo.image);
logo.x = sw / 2 - logo.image.GetWidth() / 2;
logo.y = sh / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 0);

// --- pontos de carregamento ---
ndots = 5;
spacing = 46;
dot.image = Image("dot.png");
total = (ndots - 1) * spacing;
base_x = sw / 2 - total / 2 - dot.image.GetWidth() / 2;
base_y = logo.y + logo.image.GetHeight() + 26;

for (i = 0; i < ndots; i++) {
    dots[i] = Sprite(dot.image);
    dots[i].SetPosition(base_x + i * spacing, base_y, 1);
    dots[i].SetOpacity(0.18);
}

progress = 0;
fun refresh() {
    progress++;
    step = Math.Int(progress / 5);
    phase = step - Math.Int(step / ndots) * ndots;   // modulo manual
    for (i = 0; i < ndots; i++) {
        o = 0.18;
        if (i == phase) o = 1.0;
        if (i == phase - 1) o = 0.5;
        if (i == phase + 1) o = 0.5;
        dots[i].SetOpacity(o);
    }
}
Plymouth.SetRefreshFunction(refresh);

// Mensagens do sistema (ex.: aviso de disco), discretas abaixo dos pontos
msg.sprite = Sprite();
fun message(text) {
    // Late removal of boot messages must not erase the shutdown label.
    if (Plymouth.GetMode() == "shutdown") { text = "Desligando..."; }
    msg.image = Image.Text(text, 0.6, 0.6, 0.6);
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetPosition(sw / 2 - msg.image.GetWidth() / 2, base_y + 60, 1);
}
Plymouth.SetMessageFunction(message);
if (Plymouth.GetMode() == "shutdown") {
    message("Desligando...");
}
