[Unit]
Description=Observa a EEPROM criada pelo Xemu no primeiro boot
# A unidade observa um arquivo de runtime depois da preparação. O padrão das
# unidades .path (Before=paths.target) criaria um ciclo com basic.target.
DefaultDependencies=no
After=basic.target console-prepare.service
Before=console.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=|/run/console/standalone.json
ConditionPathExists=|/run/console/live.json
ConditionPathExists=!/run/console/installer

[Path]
PathChanged=/run/console/eeprom.bin
Unit=console-eeprom.service
